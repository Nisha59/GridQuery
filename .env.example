# Copy to .env and fill in values. Never commit .env.

# --- Database ---
GRIDQUERY_DUCKDB_PATH=data/gridquery.duckdb

# --- LLM ---
# "openai" (any OpenAI-compatible API) or "ollama" (local models)
GRIDQUERY_LLM_PROVIDER=openai
GRIDQUERY_LLM_MODEL=gpt-4o-mini
GRIDQUERY_LLM_TEMPERATURE=0.0
GRIDQUERY_OPENAI_API_KEY=
# Optional: base URL for other OpenAI-compatible providers (e.g. Groq, vLLM)
GRIDQUERY_OPENAI_BASE_URL=
GRIDQUERY_OLLAMA_BASE_URL=http://localhost:11434
# Optional: USD per million tokens, for cost reporting (check your provider's price list)
GRIDQUERY_LLM_INPUT_COST_PER_MTOK=
GRIDQUERY_LLM_OUTPUT_COST_PER_MTOK=

# --- Agent safety limits ---
GRIDQUERY_MAX_SQL_ATTEMPTS=3
GRIDQUERY_EXPLAIN_MAX_ROWS=50
GRIDQUERY_QUERY_TIMEOUT_SECONDS=10
GRIDQUERY_MAX_RESULT_ROWS=10000

# --- HTTP API and UI ---
GRIDQUERY_API_HOST=127.0.0.1
GRIDQUERY_API_PORT=8000
GRIDQUERY_API_MAX_CONCURRENCY=4

# --- Evaluation ---
GRIDQUERY_EVAL_DATASET_PATH=data/eval/eval_set.jsonl
GRIDQUERY_EVAL_OUTPUT_DIR=data/eval/results
# Spending cap per evaluation run in USD (needs the LLM cost settings above)
GRIDQUERY_EVAL_MAX_COST_USD=2.0

# --- Logging ---
GRIDQUERY_LOG_LEVEL=INFO

# --- Optional LangSmith tracing (read directly by LangChain) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gridquery
